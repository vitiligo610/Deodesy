<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Deodesy.Library</PackageId>
    <Authors>Ahmed Javed</Authors>
    <Company>Deodesy</Company>
    <Description>A lightweight, high-performance geospatial utility library for .NET Standard 2.0.</Description>
    <Copyright>Copyright © $([System.DateTime]::Now.ToString(yyyy)) Ahmed Javed</Copyright>
    <PackageTags>geospatial;coordinates;geodesy;mapping;dotnet-standard</PackageTags>

    <PackageProjectUrl>https://github.com/vitiligo610/Deodesy</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vitiligo610/Deodesy.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>10</LangVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  
</Project>
